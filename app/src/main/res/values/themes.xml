<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nova" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/nova_bg</item>
    </style>
    <!-- شاشة البداية: أيقونة ثابتة (أخف على الأجهزة الضعيفة)؛ النسخة المتحركة لأندرويد 12+ في values-v31 -->
    <style name="Theme.Nova.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nova_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Nova</item>
    </style>

    <!-- حوارات النظام الأصلية (تنبيهات الصفحات، قوائم الضغط المطوّل…) بنفس هوية الواجهة: حواف 28dp وألوان التطبيق.
         الاختيار فاتح/داكن حسب إعداد المظهر داخل التطبيق (انظر novaDialog في Utils.kt). -->
    <style name="Theme.Nova.Dialog.Light" parent="@android:style/Theme.DeviceDefault.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/nova_dialog_bg_light</item>
        <item name="android:textColorPrimary">#FF141413</item>
        <item name="android:textColorSecondary">#FF6B6A68</item>
        <item name="android:colorAccent">#FFC6613F</item>
        <item name="android:windowTitleStyle">@style/Nova.DialogTitle</item>
    </style>
    <style name="Theme.Nova.Dialog.Dark" parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:windowBackground">@drawable/nova_dialog_bg_dark</item>
        <item name="android:textColorPrimary">#FFFAF9F5</item>
        <item name="android:textColorSecondary">#FFB0AEA5</item>
        <item name="android:colorAccent">#FFD97757</item>
        <item name="android:windowTitleStyle">@style/Nova.DialogTitle</item>
    </style>
    <style name="Nova.DialogTitle" parent="@android:style/TextAppearance.DeviceDefault.DialogWindowTitle">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>
</resources>
